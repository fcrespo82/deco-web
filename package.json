{
  "name": "deco-web",
  "version": "0.0.0",
  "private": true,
  "description": "Interface web para gerenciar uma rede mesh TP-Link Deco pela API local",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "DECO_MOCK=1 DATA_DIR=./data LOG_LEVEL=debug POLL_INTERVAL=30 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "vitest run",
    "probe": "node --env-file-if-exists=.env --import tsx scripts/probe.js",
    "fixture": "node scripts/make-fixture.js",
    "unlock": "tsx src/unlock.ts",
    "fetch-images": "tsx src/fetch-images.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "update-oui": "node scripts/update-oui.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "lucide-preact": "^1.59.0",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  }
}
