{
  "name": "deco-web",
  "version": "2.0.0",
  "private": true,
  "description": "Interface web para gerenciar uma rede mesh TP-Link Deco pela API local",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "DECO_MOCK=1 DATA_DIR=./data LOG_LEVEL=debug POLL_INTERVAL=30 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "test": "vitest run",
    "probe": "node --env-file-if-exists=.env --import tsx scripts/probe.js",
    "fixture": "node scripts/make-fixture.js",
    "unlock": "tsx src/unlock.ts",
    "fetch-images": "tsx src/fetch-images.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "update-oui": "node scripts/update-oui.mjs",
    "test:collectors": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s collectors/switches -p 'test_*.py'",
    "dev:pocs": "vite --config web/poc/vite.config.mjs",
    "build:pocs": "vite build --config web/poc/vite.config.mjs",
    "dev:shadcn": "vite --config web/poc/shadcn/vite.config.mjs",
    "build:shadcn": "vite build --config web/poc/shadcn/vite.config.mjs",
    "typecheck:shadcn": "tsc -p web/poc/shadcn",
    "test:shadcn": "node web/poc/shadcn/build-test.mjs && vitest run --config web/poc/shadcn/vitest.config.mjs"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@joint/core": "^4.3.4",
    "@joint/router-avoid": "^4.3.3",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@xyflow/react": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.1",
    "jsdom": "^31.0.1",
    "lucide-preact": "^1.59.0",
    "lucide-react": "^1.73.0",
    "preact": "^11.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  }
}
